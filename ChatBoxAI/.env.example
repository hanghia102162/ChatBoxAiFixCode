# Biến chỉ dùng bởi Vite dev proxy (không có tiền tố VITE_ nên khóa không bị gửi sang trình duyệt).
QWEN_API_URL=https://your-ngrok-address.ngrok-free.app
QWEN_API_KEY=replace-with-your-api-key

# Đường dẫn FastAPI ở phía frontend. Vite sẽ chuyển /api/* tới QWEN_API_URL.
# FastAPI server đã cung cấp POST /api/chat.
VITE_CHAT_API_PATH=/api/chat
